# ─────────────────────────────────────────────────────────────────────────────
# FlowForge — Environment Configuration
# Copy to .env and fill in all required values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_PASSWORD=flowforge_dev
DATABASE_URL=postgresql://flowforge:flowforge_dev@localhost:5432/flowforge

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_dev
REDIS_URL=redis://:redis_dev@localhost:6379

# ── Message Queue (RabbitMQ) ──────────────────────────────────────────────────
RABBITMQ_PASSWORD=rabbitmq_dev
RABBITMQ_URL=amqp://flowforge:rabbitmq_dev@localhost:5672

# ── JWT (generate with: openssl rand -base64 32) ─────────────────────────────
JWT_SECRET=CHANGE_ME_MUST_BE_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_MUST_BE_AT_LEAST_32_CHARS
JWT_REFRESH_EXPIRY=30d

# ── OAuth (optional) ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Stripe (optional — billing disabled if empty) ─────────────────────────────
STRIPE_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_STARTER=price_xxxx
STRIPE_PRICE_PRO=price_xxxx

# ── Email / SMTP ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@flowforge.io

# ── AWS S3 (file uploads — optional) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_WORKFLOWS=true
ENABLE_INTEGRATIONS=true
ENABLE_ANALYTICS=true
ENABLE_AI_AGENTS=false
